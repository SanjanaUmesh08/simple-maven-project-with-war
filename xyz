pipeline {
    agent any

    tools {
        maven 'Maven3'   // Make sure Jenkins has Maven installed with this name
        jdk 'Java11'     // Ensure JDK11 (or whichever version you installed) is configured in Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/SanjanaUmesh08/simple-maven-project-with-war.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Deploy') {
            steps {
                sh 'cp target/*.war /opt/tomcat/webapps/'
            }
        }
    }
}
